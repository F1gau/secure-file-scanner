# Copy to .env and adjust. Never commit the real .env file.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://scanner:scanner@db:5432/scanner
REDIS_URL=redis://redis:6379/0
# Generate a real value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12
MAX_FILE_SIZE_MB=10
STORAGE_PATH=/data/storage
RATE_LIMIT_LOGIN=5
RATE_LIMIT_UPLOAD=20
MAX_ARCHIVE_FILES=500
MAX_EXTRACTED_SIZE_MB=100
MAX_ARCHIVE_DEPTH=2
SCAN_TIME_LIMIT_SECONDS=300
CELERY_TASK_ALWAYS_EAGER=false
LOG_LEVEL=INFO
